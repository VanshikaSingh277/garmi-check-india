{
  "name": "thandak-web",
  "private": true,
  "version": "0.3.0",
  "description": "Thandak frontend: one codebase for the website and the Android / iOS apps (Capacitor).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:app": "vite build --mode app",
    "preview": "vite preview",
